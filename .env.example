# Copy to .env and adjust for your machine. Never commit a real .env file.

NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/context_api
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# GitHub gateway
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_REPOSITORY_ACCESS=all
GITHUB_REPOSITORY_ALLOWLIST=
ZORO_GITHUB_API_KEY=

# Account-level repository creation (github.write/createRepository only).
#
# Separate from the GitHub App credentials above, which cannot create a
# repository. Leaving GITHUB_REPOSITORY_CREATION_ENABLED false keeps the whole
# group optional; setting it true makes both variables below required at startup
# rather than at the first call.
#
# GITHUB_ALLOWED_OWNER has no built-in default: the documented value is
# kofiarhin, but the application never assumes it, so a dropped variable fails
# loudly instead of silently widening which account can be written to.
#
# GITHUB_USER_ACCESS_TOKEN is a real user credential. It is never logged,
# returned, or echoed, and repository deletion is not offered at all.
GITHUB_REPOSITORY_CREATION_ENABLED=false
GITHUB_ALLOWED_OWNER=kofiarhin
GITHUB_USER_ACCESS_TOKEN=

# Vercel gateway
VERCEL_TOKEN=
ZORO_VERCEL_API_KEY=
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=
VERCEL_PROJECT_ALLOWLIST=
VERCEL_DOMAIN_ALLOWLIST=
VERCEL_REPOSITORY_ALLOWLIST=
# Branch Vercel deploys to Production. Preview deployments are refused on it.
# Optional: when unset the project's linked production branch is used instead.
VERCEL_PRODUCTION_BRANCH=
VERCEL_ALLOW_DESTRUCTIVE_OPERATIONS=false

# Heroku gateway (/api/v1/heroku). Never commit populated secrets.
HEROKU_API_TOKEN=
ZORO_HEROKU_API_KEY=
HEROKU_RESOURCE_ACCESS=allowlist
HEROKU_APP_ALLOWLIST=
HEROKU_TEAM_ALLOWLIST=
HEROKU_PIPELINE_ALLOWLIST=
HEROKU_SPACE_ALLOWLIST=
HEROKU_DOMAIN_SUFFIX_ALLOWLIST=
HEROKU_ADDON_PLAN_ALLOWLIST=
HEROKU_DYNO_SIZE_ALLOWLIST=
HEROKU_SELF_APP=
HEROKU_MUTATIONS_ENABLED=false
HEROKU_DESTRUCTIVE_OPERATIONS_ENABLED=false
HEROKU_BILLING_OPERATIONS_ENABLED=false
HEROKU_ACCESS_ADMIN_OPERATIONS_ENABLED=false
HEROKU_PRIVATE_SPACE_OPERATIONS_ENABLED=false
HEROKU_MAX_DYNO_QUANTITY=10
HEROKU_REQUEST_TIMEOUT_MS=15000
HEROKU_LOG_FETCH_TIMEOUT_MS=10000

# Unified Zoro engineering dispatcher (POST /api/v1/zoro/operations/:operationId).
# This is the only secret the unified route owns. It does not replace or expose
# the GitHub App credentials, the Vercel token, or the Heroku API token above:
# those stay server-side and are read only by their own gateways. Minimum 32
# characters. Leave blank to keep the dispatcher disabled (it fails closed).
ZORO_ENGINEERING_API_KEY=

# Full Operator mode. Defaults to true when omitted or blank; any value other
# than true/false fails startup rather than guessing.
#
# When enabled, the unified dispatcher proceeds without per-request Kofi
# approval for write, merge, production-sensitive, security-sensitive, billing,
# and access-admin work — enabling the mode is the standing approval.
#
# It does NOT relax: destructive operations (which still need approval and an
# exact resource-naming confirmation), expected SHA/ETag/release checks,
# provider allowlists and account boundaries, the provider feature switches
# below, secret redaction, Context API self-protection, branch protection, or
# the closed operation catalogue. Set false to restore per-request approval.
ZORO_FULL_OPERATOR_MODE=true

# Destructive work through the unified dispatcher. Separate from Full Operator
# mode and left closed by default.
ZORO_ENGINEERING_DESTRUCTIVE_OPERATIONS_ENABLED=false
